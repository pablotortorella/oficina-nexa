# Copia este archivo como .env (en esta misma carpeta) para que los agentes respondan con un modelo real.
# Sin clave, la oficina funciona igual con sus frases locales.

# Clave de la API de Anthropic: se crea en https://console.anthropic.com (API keys).
# Requiere saldo cargado en esa consola. NO es tu suscripción de Claude (Pro o Max): se cobra aparte.
# Se queda en tu equipo: solo la lee el servidor local, nunca llega al navegador.
ANTHROPIC_API_KEY=

# Modelo que responde. Cámbialo si tu cuenta usa otro id.
ANTHROPIC_MODEL=claude-haiku-5-5

# Tu nombre, para que los agentes te llamen así. Vacío: te hablan de tú, sin nombre.
TU_NOMBRE=

# Motor que responde: "api" (por defecto, usa ANTHROPIC_API_KEY) o "codex".
# Con "codex" responde la CLI de Codex con tu sesión de ChatGPT (sin clave de API ni costo extra;
# gasta el uso de tu plan). Requiere `codex` instalado y con sesión iniciada (`codex login`).
# Corre sin herramientas: no ejecuta comandos ni navega. Cada orden tarda unos 10 a 20 s.
MOTOR=api

# Modelo de Codex. Vacío: el que trae Codex por defecto.
CODEX_MODEL=

# Carpeta donde los agentes de la oficina real (modo laboratorio, http://127.0.0.1:5180/) dejan
# su trabajo: una subcarpeta por agente, sobre-mi.md, contexto.md y tareas.json.
# Vacío: ~/Dropbox/oficina-trabajo
OFICINA_TRABAJO=

# Voz local de Nexa (opcional; estos son los valores por defecto).
# Piper habla: carpeta con bin/piper/piper y voces/<voz>.onnx
PIPER_DIR=
PIPER_VOZ=es_AR-daniela-high
# whisper.cpp escucha los dictados: carpeta con ggml-large-v3-turbo.bin (y el VAD de Silero, opcional)
WHISPER_MODELOS=
# GPU para dictar: vacío = detectar (solo GPU dedicada; la integrada es más lenta que la CPU).
# 1 = forzar GPU, 0 = siempre CPU (usa ggml-large-v3-turbo-q5_0.bin, más liviano).
WHISPER_GPU=
